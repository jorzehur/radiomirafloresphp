# Evitar listado de directorios
Options -Indexes

# ------------------------------------------------------------
#  Seguridad
# ------------------------------------------------------------

# Proteger archivos sensibles
<FilesMatch "^(database\.sql|README\.md|PRODUCCION\.md|test-viewport\.html)$">
    Require all denied
</FilesMatch>

# Proteger la carpeta includes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^includes/ - [F,L]
</IfModule>

# Cabeceras de seguridad
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.fbcdn.net https://www.facebook.com https://web.facebook.com https://i.ytimg.com https://img.youtube.com https://maps.gstatic.com https://maps.googleapis.com; frame-src 'self' https://www.youtube-nocookie.com https://www.youtube.com https://www.google.com https://maps.google.com https://www.facebook.com https://web.facebook.com; connect-src 'self' https://graph.facebook.com https://www.facebook.com https://maps.googleapis.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# ------------------------------------------------------------
#  Rendimiento: caché del navegador y compresión
# ------------------------------------------------------------

# No cachear páginas dinámicas (PHP)
<FilesMatch "\.(php)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    </IfModule>
</FilesMatch>

# Cachear archivos estáticos durante 30 días
<FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|ico|woff2?)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "public, max-age=2592000"
    </IfModule>
</FilesMatch>

# Compresión GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml image/svg+xml
</IfModule>

# ------------------------------------------------------------
#  HTTPS obligatorio (se omite en local para no romper XAMPP)
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# HSTS solo cuando ya se navega por HTTPS
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    Header unset X-Powered-By
</IfModule>

# Ocultar la version de PHP en las cabeceras (solo si PHP va como modulo Apache)
<IfModule mod_php.c>
    php_flag expose_php off
</IfModule>
<IfModule php_module>
    php_flag expose_php off
</IfModule>

# ------------------------------------------------------------
#  El repositorio de git NUNCA debe ser descargable por web
#  (.git/config, .git/HEAD... expondrian todo el codigo fuente)
# ------------------------------------------------------------
<IfModule mod_alias.c>
    RedirectMatch 404 (?i)/\.git
</IfModule>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (?i)(^|/)\.git - [F,L]
</IfModule>

# Otros archivos que no deben descargarse nunca
<FilesMatch "^(\.env.*|\.gitignore|\.user\.ini|.*\.(sql|bak|old|log|zip|sh|lock|dist|orig))$">
    Require all denied
</FilesMatch>
